# Copy to .env (gitignored) and adjust.

# --- Server (docker compose, or the container's environment) ---
# Address your collaborators' machines use to reach the board. Its host is accepted automatically.
BOARD_PUBLIC_URL=http://myserver:8792
# Extra Host headers to accept, comma-separated host:port patterns (host:* = any port).
BOARD_ALLOWED_HOSTS=192.168.1.10:*,myserver.example-tailnet.ts.net:*
# Host port for docker compose.
BOARD_PORT=8792

# --- deploy/unraid/deploy.sh (only if you deploy to Unraid over SSH) ---
DEPLOY_SSH_TARGET=root@192.168.1.10
# DEPLOY_APPDATA=/mnt/user/appdata/claude-board
# Port where the container answers on the server's 127.0.0.1 (health check):
# DEPLOY_PORT=8792
# On Windows Git Bash, use the Windows OpenSSH client so the Windows ssh-agent is used:
# SSH=/c/Windows/System32/OpenSSH/ssh.exe
